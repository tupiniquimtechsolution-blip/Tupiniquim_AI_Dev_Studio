{
  "name": "tupiniquim-ai-dev-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma privada local-first de engenharia de software agêntica.",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "pnpm build && electron-builder --win portable dir",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "test:dogfood": "vitest run --project dogfood",
    "validate:e-drive": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-e-drive.ps1",
    "validate": "pnpm validate:e-drive && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm build"
  },
  "build": {
    "appId": "br.com.tupiniquim.devstudio",
    "productName": "Tupiniquim AI Dev Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "artifactName": "Tupiniquim-AI-Dev-Studio-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xstate/react": "6.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.31.0",
    "monaco-editor": "0.56.0",
    "node-pty": "1.2.0-beta.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.2",
    "xstate": "5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
